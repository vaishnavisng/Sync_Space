PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace
JWT_SECRET=replace_with_a_long_random_secret
# Gmail SMTP: use the full Gmail address and a 16-character Google App Password.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_google_app_password
# Recommended for hosts that block SMTP (such as Render free instances):
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM="SyncSpace <verified-sender@your-domain.com>"
GEMINI_API_KEY=
