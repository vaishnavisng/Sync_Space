PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace
JWT_SECRET=replace_with_a_long_random_secret
# Email delivery: set to brevo, resend, gmail, or auto.
EMAIL_PROVIDER=brevo
# Brevo: verify this Gmail address as a Sender in Brevo, then add its API key.
EMAIL_USER=your_gmail_address@gmail.com
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Gmail-only fallback (not reliable on hosts that block SMTP):
# EMAIL_PASS=your_16_character_google_app_password
# Resend requires a verified domain to deliver to email addresses other than your own:
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM="SyncSpace <verified-sender@your-domain.com>"
GEMINI_API_KEY=
